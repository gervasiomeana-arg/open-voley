# OPEN VOLEY - environment template
# Never commit real production secrets to the repository.

# GEMINI_API_KEY: Required for Gemini AI API calls.
# Configure this through the deployment/AI Studio secrets panel.
GEMINI_API_KEY=""

# APP_URL: Public URL where OPEN VOLEY is hosted.
APP_URL=""

# MERCADOPAGO_ACCESS_TOKEN: Mercado Pago production or sandbox access token.
# SECRET. Configure only in the deployment secrets/environment.
MERCADOPAGO_ACCESS_TOKEN=""

# MERCADOPAGO_PUBLIC_KEY: Mercado Pago public key used by Checkout.
# This value is public by design, but keep environment-specific configuration here.
MERCADOPAGO_PUBLIC_KEY=""

# GOOGLE_CLIENT_ID: OAuth 2.0 Client ID used by the backend to verify Google ID tokens.
GOOGLE_CLIENT_ID=""

# SESSION_SECRET: High-entropy secret used to sign and verify session JWTs.
# Generate a unique random value for every production environment.
# Do not reuse API keys, passwords, admin codes, or repository values.
SESSION_SECRET=""
