# OPEN VOLEY - environment template
# Never commit real production secrets to the repository.

# GEMINI_API_KEY: Required for Gemini AI API calls.
# Configure this through the deployment/AI Studio secrets panel.
GEMINI_API_KEY=""
# Optional server-side model override; never put private API keys in VITE variables.
GEMINI_MODEL="gemini-3.8-flash"

# APP_URL: Public URL where OPEN VOLEY is hosted.
APP_URL=""

# MERCADOPAGO_ACCESS_TOKEN: Mercado Pago production or sandbox access token.
# SECRET. Configure only in the deployment secrets/environment.
MERCADOPAGO_ACCESS_TOKEN=""

# MERCADOPAGO_PUBLIC_KEY: Mercado Pago public key used by Checkout.
# This value is public by design, but keep environment-specific configuration here.
MERCADOPAGO_PUBLIC_KEY=""

# GOOGLE_CLIENT_ID: OAuth 2.0 Client ID used by the backend to verify Google ID tokens.
GOOGLE_CLIENT_ID=""

# VITE_GOOGLE_CLIENT_ID: Same Google Web Client ID exposed to the browser for Google Identity Services.
# This is an OAuth client identifier, not a secret. Keep it environment-specific.
VITE_GOOGLE_CLIENT_ID=""

# SESSION_SECRET: High-entropy secret used to sign and verify session JWTs.
# Generate a unique random value for every production environment.
# Do not reuse API keys, passwords, admin codes, or repository values.
SESSION_SECRET=""

# ADMIN_EMAILS: Comma-separated allowlist for administrative endpoints.
# Every listed email must also correspond to an existing, non-blocked OPEN VOLEY account.
# Example: admin1@example.com,admin2@example.com
ADMIN_EMAILS=""

# HMAC secret from Mercado Pago Webhooks settings; server only.
MERCADOPAGO_WEBHOOK_SECRET=""
# Opt in only after configuring and testing Subscriptions + signed webhooks.
# Argentina / ARS only. Does not convert existing manual payments to recurring.
MERCADOPAGO_SUBSCRIPTIONS_ENABLED="false"
# Persistent SQLite path (accounts JSON and videos also need persistent storage).
OPENVOLEY_DB_PATH=""
# Resource ceilings for a single server instance.
OPENVOLEY_MAX_VIDEO_MB=250
OPENVOLEY_VIDEO_QUOTA_MB=2000
OPENVOLEY_AI_HOURLY_LIMIT=200

# WhatsApp Cloud API: server-side only, NEVER VITE_ variables.
# Enable only after sender registration + approved template + recipient consent.
WHATSAPP_TRIAL_ALERTS_ENABLED="false"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ADMIN_TO=""
WHATSAPP_TRIAL_TEMPLATE=""
WHATSAPP_TEMPLATE_LANGUAGE="es_AR"
WHATSAPP_GRAPH_VERSION="v25.0"
