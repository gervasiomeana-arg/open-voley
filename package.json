{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx secure-server.ts",
    "build": "vite build && esbuild secure-server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.cjs",
    "lint": "tsc --noEmit",
    "test:analytics": "tsx src/utils/dataVolleyAnalytics.test.ts",
    "test:evidence": "tsx src/utils/evidenceInsights.test.ts",
    "test:training-evidence": "tsx src/utils/trainingEvidence.test.ts",
    "test:performance-followup": "tsx src/utils/performanceFollowUp.test.ts",
    "test:training-storage": "tsx src/services/trainingStorage.test.ts",
    "test:training-backend": "tsx src/server/trainingSessionsStore.test.ts",
    "test:training-sync": "tsx src/services/trainingSync.test.ts",
    "test:training-sqlite": "tsx src/server/trainingSqliteRepository.test.ts",
    "test:sqlite-rollout": "tsx src/server/trainingRepositoryRollout.test.ts",
    "test:montage-sqlite": "tsx src/server/smartSportsMontageRepository.test.ts",
    "test:montage-sync": "tsx src/services/smartSportsMontageSync.test.ts",
    "test:video-render": "tsx src/server/videoRenderPlan.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "google-auth-library": "^11.1.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
