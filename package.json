{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "tsx secure-server.ts",
    "build": "vite build && esbuild src/server/serverCore.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=server-build/server.cjs && esbuild scripts/prerenderLanding.tsx --bundle --platform=node --format=esm --packages=external --loader:.css=empty --outfile=server-build/prerender.mjs && node server-build/prerender.mjs",
    "start": "node server.ts",
    "clean": "rm -rf dist server.cjs",
    "lint": "tsc --noEmit",
    "test:launch-security": "node --import tsx src/server/launchSecurity.test.ts && node --import tsx src/services/userStorage.test.ts",
    "test:analytics": "tsx src/utils/dataVolleyAnalytics.test.ts",
    "test:evidence": "tsx src/utils/evidenceInsights.test.ts",
    "test:training-evidence": "tsx src/utils/trainingEvidence.test.ts",
    "test:performance-followup": "tsx src/utils/performanceFollowUp.test.ts",
    "test:training-storage": "tsx src/services/trainingStorage.test.ts",
    "test:training-backend": "tsx src/server/trainingSessionsStore.test.ts",
    "test:training-sync": "tsx src/services/trainingSync.test.ts",
    "test:training-sqlite": "tsx src/server/trainingSqliteRepository.test.ts",
    "test:sqlite-rollout": "tsx src/server/trainingRepositoryRollout.test.ts",
    "test:montage-sqlite": "tsx src/server/smartSportsMontageRepository.test.ts",
    "test:montage-sync": "tsx src/services/smartSportsMontageSync.test.ts",
    "test:video-render": "node --import tsx src/server/videoRenderPlan.test.ts && node --import tsx src/components/ComputerVisionOverlay.test.ts",
    "test:player360": "tsx src/utils/player360Analytics.test.ts",
    "test:open-ai-context": "tsx src/utils/openAiConversationContext.test.ts",
    "test:e2e-real-match": "tsx src/utils/endToEndRealMatch.test.ts",
    "test:match-rotation": "tsx src/utils/matchRotationEngine.test.ts",
    "test:scout-rally-assist": "tsx src/utils/scoutRallyAssist.test.ts",
    "test:match-set": "tsx src/utils/matchSetEngine.test.ts",
    "test:match-substitution": "tsx src/utils/matchSubstitutionEngine.test.ts",
    "test:libero": "tsx src/utils/liberoEngine.test.ts",
    "test:match-state": "tsx src/utils/matchStateIntegrity.test.ts",
    "test:set-transition": "tsx src/utils/setTransitionIntegrity.test.ts",
    "test:match-regression": "tsx src/utils/matchStateIntegrity.test.ts && tsx src/utils/matchSubstitutionEngine.test.ts && tsx src/utils/liberoEngine.test.ts",
    "test:real-match-simulation": "tsx src/utils/realMatchSimulation.test.ts",
    "test:rally-simulation-v2": "tsx src/utils/rallySimulationV2.test.ts",
    "recovery": "node --import tsx scripts/recovery.ts",
    "test:recovery": "node --import tsx src/server/recoveryBackup.test.ts && node --import tsx src/services/legacyRecovery.test.ts",
    "test:teams-recovery": "node --import tsx src/services/teamStorageRecovery.test.ts",
    "test:payments": "node --import tsx src/server/paymentProcessing.test.ts",
    "check:launch": "node --import tsx scripts/checkLaunch.ts",
    "test:media-cards": "node --import tsx src/utils/mediaCardData.test.ts",
    "test:readiness": "node --import tsx src/server/launchReadiness.test.ts && node --import tsx src/server/launchStorageStatus.test.ts",
    "test:landing": "node scripts/checkLanding.mjs",
    "test:durable-storage": "node --import tsx src/server/durableStorage.test.ts && node --import tsx src/services/userDataSync.test.ts",
    "test:competitions": "node --import tsx src/shared/competitions.test.ts && node --import tsx src/services/competitionStorage.test.ts",
    "test:manual-access": "node --import tsx src/server/manualAccess.test.ts",
    "test:coach-review": "node --import tsx src/utils/coachReview.test.ts",
    "test:ai-generation": "node --import tsx src/server/aiGeneration.test.ts && node --import tsx src/shared/aiErrors.test.ts",
    "test:video-integration": "node --import tsx src/server/videoRenderIntegration.test.ts",
    "test:scout-court": "node --import tsx src/utils/scoutCourtLayout.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "google-auth-library": "^11.1.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
